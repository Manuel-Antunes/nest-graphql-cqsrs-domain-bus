{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.next",
      "!**/.open-next",
      "!**/vite.config.*.timestamp*",
      "!**/vitest.config.*.timestamp*",
      "!**/next-env.d.ts",
      "!apps/web/public",
      "!apps/web/src/gql",
      "!apps/web-e2e/src/gql",
      "!apps/web/schema.graphql",
      "!schema.graphql",
      "!apps/migrator/src/migrations"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "experimentalEmbeddedSnippetsEnabled": true,
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "preserve"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "graphql": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noStaticOnlyClass": "off"
      },
      "suspicious": {
        "noDuplicateFields": "error"
      },
      "style": {
        "useImportType": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@nestposts/*/src/**", "@nestposts/*/dist/**"],
                "message": "Import a workspace package through its exports map (@nestposts/<pkg>/<path>), not through src/ or dist/."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":BUN:",
              ":NODE:",
              ["react", "react-dom", "react/**", "react-dom/**"],
              ["next", "next/**"],
              ":PACKAGE:",
              ":BLANK_LINE:",
              ["@/**"],
              ":BLANK_LINE:",
              [":PATH:"]
            ],
            "sortBareImports": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**", "apps/web-e2e/**"],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended",
          "test": "recommended"
        }
      }
    },
    {
      "includes": ["apps/web/src/**/*.{ts,tsx}", "!apps/web/src/nest/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "warn"
          },
          "nursery": {
            "useSortedClasses": {
              "level": "warn",
              "options": {
                "functions": ["cn", "cva", "clsx", "twMerge"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/**/*.ts", "infra/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "warn"
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/src/fixtures/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/src/model/**", "apps/web-e2e/src/support/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestposts/*/src/**", "@nestposts/*/dist/**"],
                    "message": "Import a workspace package through its exports map (@nestposts/<pkg>/<path>), not through src/ or dist/."
                  },
                  {
                    "group": [
                      "../**/environment/**",
                      "../**/infrastructure/**",
                      "../**/pages/**",
                      "../**/components/**",
                      "../**/workflows/**",
                      "../**/fixtures/**",
                      "../**/stack/**",
                      "../**/specs/**"
                    ],
                    "message": "model/ and support/ are the innermost layer of the e2e suite: they depend on nothing else in it."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/src/environment/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestposts/*/src/**", "@nestposts/*/dist/**"],
                    "message": "Import a workspace package through its exports map (@nestposts/<pkg>/<path>), not through src/ or dist/."
                  },
                  {
                    "group": [
                      "../**/infrastructure/**",
                      "../**/pages/**",
                      "../**/components/**",
                      "../**/workflows/**",
                      "../**/fixtures/**",
                      "../**/stack/**",
                      "../**/specs/**"
                    ],
                    "message": "environment/ is what the global setup hands the workers; it knows no client, screen or workflow."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/src/infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestposts/*/src/**", "@nestposts/*/dist/**"],
                    "message": "Import a workspace package through its exports map (@nestposts/<pkg>/<path>), not through src/ or dist/."
                  },
                  {
                    "group": [
                      "../**/pages/**",
                      "../**/components/**",
                      "../**/workflows/**",
                      "../**/fixtures/**",
                      "../**/stack/**",
                      "../**/specs/**"
                    ],
                    "message": "infrastructure/ talks to the system from outside the browser; it knows no screen and no workflow."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web-e2e/src/pages/**",
        "apps/web-e2e/src/components/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestposts/*/src/**", "@nestposts/*/dist/**"],
                    "message": "Import a workspace package through its exports map (@nestposts/<pkg>/<path>), not through src/ or dist/."
                  },
                  {
                    "group": [
                      "../**/environment/**",
                      "../**/infrastructure/**",
                      "../**/workflows/**",
                      "../**/fixtures/**",
                      "../**/stack/**",
                      "../**/specs/**"
                    ],
                    "message": "A page or component object drives the browser and nothing else: a database, a mailbox or a flow across screens belongs to a workflow."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/src/workflows/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestposts/*/src/**", "@nestposts/*/dist/**"],
                    "message": "Import a workspace package through its exports map (@nestposts/<pkg>/<path>), not through src/ or dist/."
                  },
                  {
                    "group": [
                      "../**/fixtures/**",
                      "../**/stack/**",
                      "../**/specs/**"
                    ],
                    "message": "A workflow is composed by the fixtures, never the other way round, and knows nothing about provisioning the stack."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/src/stack/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestposts/*/src/**", "@nestposts/*/dist/**"],
                    "message": "Import a workspace package through its exports map (@nestposts/<pkg>/<path>), not through src/ or dist/."
                  },
                  {
                    "group": [
                      "../**/pages/**",
                      "../**/components/**",
                      "../**/fixtures/**",
                      "../**/specs/**"
                    ],
                    "message": "stack/ provisions the system for the global setup; it drives no screen."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/src/specs/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@nestposts/*/src/**", "@nestposts/*/dist/**"],
                    "message": "Import a workspace package through its exports map (@nestposts/<pkg>/<path>), not through src/ or dist/."
                  },
                  {
                    "group": [
                      "../**/stack/**",
                      "../**/environment/**",
                      "../**/pages/**",
                      "../**/components/**"
                    ],
                    "message": "A spec is told through the fixtures: screens come as `app`, workflows as fixtures, the run's settings as `environment`."
                  },
                  {
                    "group": [
                      "@playwright/test",
                      "pg",
                      "testcontainers",
                      "@testcontainers/*",
                      "@aws-sdk/*",
                      "@polar-sh/*",
                      "graphql",
                      "graphql-sse"
                    ],
                    "message": "A spec reaches the system through the fixtures and the objects they give it (`../fixtures/test`), not through a driver of its own."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web-e2e/src/specs/**/*.spec.ts"],
      "plugins": ["./tools/biome/playwright.grit"]
    },
    {
      "includes": [
        "apps/web/src/**/*.ts",
        "apps/web/src/**/*.tsx",
        "!apps/web/src/gql/**"
      ],
      "plugins": [
        "./tools/biome/graphql-operations.grit",
        "./tools/biome/tailwind.grit"
      ]
    },
    {
      "includes": ["libs/ui/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        },
        "rules": {
          "style": {
            "useImportType": "warn"
          },
          "nursery": {
            "useSortedClasses": {
              "level": "warn",
              "options": {
                "functions": ["cn", "cva", "clsx", "twMerge"]
              }
            }
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off",
            "useFocusableInteractive": "off",
            "useAriaPropsSupportedByRole": "off",
            "useAriaPropsForRole": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "noRedundantRoles": "off"
          },
          "suspicious": {
            "useIterableCallbackReturn": "off",
            "noDoubleEquals": "off",
            "noArrayIndexKey": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
