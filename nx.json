{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.mts",
      "!{projectRoot}/vitest.e2e.config.mts",
      "!{projectRoot}/test/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/vitest.shared.mts",
      "{workspaceRoot}/biome.json"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "run"
      },
      "exclude": ["apps/chatwoot/**/*"]
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e-ci"
      }
    },
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": {
          "name": "docker:build",
          "cwd": ".",
          "skipDefaultTag": true
        },
        "runTarget": {
          "name": "docker:run"
        }
      }
    },
    {
      "plugin": "nx-ruby-on-rails"
    }
  ],
  "analytics": false,
  "parallel": 8,
  "targetDefaults": {
    "test": {
      "dependsOn": ["^build"]
    },
    "prune-lockfile": {
      "executor": "@nx/js:prune-lockfile",
      "cache": true,
      "dependsOn": ["build"],
      "outputs": [
        "{projectRoot}/dist/package.json",
        "{projectRoot}/dist/pnpm-lock.yaml",
        "{projectRoot}/dist/pnpm-workspace.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "executor": "@nx/js:copy-workspace-modules",
      "cache": true,
      "dependsOn": ["build", "^build"],
      "outputs": ["{projectRoot}/dist/workspace_modules"],
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "executor": "nx:noop",
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"]
    }
  }
}
