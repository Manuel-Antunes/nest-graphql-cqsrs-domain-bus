# Where the telemetry of EVERY function goes — the Better Stack source's ingesting host and its
# token. `sst deploy` loads this file on its own; a missing value stops the deploy instead of
# publishing a stack that reports nothing.
BETTER_STACK_URL=
BETTER_STACK_API_KEY=
# The address, or the domain, the notificator sends email as through SES on AWS. Required by
# `sst deploy`; an address is verified by the link SES mails to it on the first deploy. When the
# identity is already verified in the account and managed elsewhere, set MAIL_SENDER_EXISTING=true:
# the stack then only grants the permission to send through it, and never creates or deletes it.
MAIL_SENDER=
MAIL_SENDER_EXISTING=false
# Optional: a domain of the stage's own. The router answers on app.<BASE_DOMAIN> (production) or
# <stage>.<BASE_DOMAIN>, with records in the Cloudflare zone CLOUDFLARE_ZONE_ID names, created with
# CLOUDFLARE_API_TOKEN (and CLOUDFLARE_DEFAULT_ACCOUNT_ID when the token cannot read the account).
# Empty, the stage stays on its CloudFront URL — Chatwoot included, which is routed by path. A new
# stage also needs `sst secret set ChatwootSecretKeyBase $(openssl rand -hex 64)` once.
BASE_DOMAIN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=
# Where the notificator sends email locally: Mailpit, from `docker compose up -d mailpit`.
MAIL_SMTP_URL=smtp://localhost:1025
# Better Auth's secondary storage (sessions in front of Postgres) and the Nest cache, from
# `docker compose up -d redis`. Every process that holds Better Auth — the web, posts-api, the
# notificator, the gateway, the migrator — reads it, so it is set for all of them or for none.
# Unset, there is no Redis at all: sessions are read from Postgres and the cache is in memory.
REDIS_URL=redis://localhost:6379
DRIVE_DISK=public
DRIVE_BUCKET=local
DRIVE_AWS_REGION=us-east-1
DRIVE_AWS_ACCESS_KEY_ID=sail
DRIVE_AWS_SECRET_ACCESS_KEY=password
DRIVE_S3_ENDPOINT=http://localhost:9000

SENTRY_BASE_URL=
SENTRY_TOKEN=
GLITCHTIP_DISCORD_WEBHOOK_URL=

# Billing in apps/web, through Polar (libs/billing). No token means no billing at all: no tab, no
# route, no endpoint. POLAR_ENVIRONMENT is `sandbox` unless it says `production` — and production
# is real checkouts against real products. The webhook secret is only needed for Polar to deliver.
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=
POLAR_WEBHOOK_SECRET=
NGROK_AUTH_TOKEN=

# Preconfigured Google OAuth provider, works out-of-the-box
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# apps/chatwoot, which keeps its tables in the `chatwoot` schema of the same Postgres (the
# defaults point at the compose one). It verifies the platform's session cookie with AUTH_SECRET,
# so it is set for it exactly as for every process that holds Better Auth. The web embeds it from
# CHATWOOT_URL and the gateway calls it at CHATWOOT_SUBGRAPH_URL.
CHATWOOT_PORT=3100
FRONTEND_URL=http://localhost:3100
CHATWOOT_URL=http://localhost:3100
CHATWOOT_SUBGRAPH_URL=http://localhost:3100/graphql

# Theo (apps/theo-agent, AG-UI, :8080), the posts agent (apps/posts-agent, A2A, :9000) and the
# posts MCP server (apps/mcp, :8000). A caller's token is issued for all three — the web issues it
# for whoever is signed in, for /theo — and each forwards it to the next: every Better Auth process
# must accept the MCP server's audience, and the migrator registers the agents' too. Without this
# line only the gateway is a resource and the MCP server's calls are refused. The agents reach
# Bedrock with the AWS SDK's own credentials (AWS_PROFILE, or a role).
# AUTH_OAUTH_RESOURCES=http://localhost:4000/graphql,http://localhost:8000/mcp,http://localhost:9000/,http://localhost:8080/
# POSTS_AGENT_MODEL_ID=global.anthropic.claude-sonnet-5-5
# THEO_AGENT_MODEL_ID=global.anthropic.claude-sonnet-5-5
# THEO_A2A_AGENTS=http://localhost:9000/
# THEO_AGENT_URL=http://localhost:8080/invocations
# THEO_AGENT_AUDIENCES=http://localhost:8080/,http://localhost:9000/,http://localhost:8000/mcp
# COPILOTKIT_TELEMETRY_DISABLED=true
# AWS_PROFILE=
