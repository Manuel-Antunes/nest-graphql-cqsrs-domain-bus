{
  "name": "@nestposts/infra",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "infra/aws",
  "implicitDependencies": [
    "@nestposts/gateway",
    "@nestposts/posts-api",
    "@nestposts/tagging",
    "@nestposts/notificator",
    "@nestposts/migrator",
    "@nestposts/web"
  ],
  "targets": {
    "build-functions": {
      "executor": "nx:noop",
      "dependsOn": ["^prune", "^build-deps"]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm sst deploy",
        "cwd": "."
      },
      "configurations": {
        "production": {
          "command": "pnpm sst deploy --stage production"
        },
        "dev": {
          "command": "pnpm sst deploy --stage dev"
        }
      },
      "dependsOn": ["build-functions"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm sst dev",
        "cwd": "."
      }
    },
    "diff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm sst diff",
        "cwd": "."
      }
    },
    "remove": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm sst remove",
        "cwd": "."
      }
    },
    "unlock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm sst unlock",
        "cwd": "."
      }
    },
    "graph": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./infra/scripts/stack-graph.sh",
        "cwd": "."
      }
    },
    "discover": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./infra/scripts/discover.sh",
        "cwd": "."
      }
    }
  }
}
