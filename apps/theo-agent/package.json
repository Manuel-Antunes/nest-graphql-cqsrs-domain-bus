{
  "name": "@nestposts/theo-agent",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@ag-ui/client": "catalog:",
    "@ag-ui/core": "catalog:",
    "@ag-ui/encoder": "catalog:",
    "@automapper/classes": "^9.0.2",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-agentcore": "catalog:",
    "@aws-sdk/credential-providers": "^3.1144.0",
    "@aws-sdk/util-endpoints": "catalog:",
    "@better-auth/oauth-provider": "^1.7.3",
    "@keyv/redis": "catalog:",
    "@langchain/aws": "catalog:langchain",
    "@langchain/core": "catalog:langchain",
    "@langchain/langgraph": "catalog:langchain",
    "@langchain/langgraph-checkpoint": "catalog:langchain",
    "@langfuse/langchain": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/decorators": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/storage": "^0.0.1",
    "@opentelemetry/api": "catalog:otel",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:otel",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:otel",
    "@opentelemetry/instrumentation-amqplib": "catalog:otel",
    "@opentelemetry/instrumentation-aws-sdk": "catalog:otel",
    "@opentelemetry/instrumentation-http": "catalog:otel",
    "@opentelemetry/instrumentation-nestjs-core": "catalog:otel",
    "@opentelemetry/instrumentation-pg": "catalog:otel",
    "@opentelemetry/instrumentation-pino": "catalog:otel",
    "@opentelemetry/resources": "catalog:otel",
    "@opentelemetry/sdk-logs": "catalog:otel",
    "@opentelemetry/sdk-node": "catalog:otel",
    "@opentelemetry/sdk-trace-base": "catalog:otel",
    "@opentelemetry/semantic-conventions": "catalog:otel",
    "@redis/client": "catalog:",
    "@sentry/nestjs": "catalog:",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "bedrock-agentcore": "catalog:",
    "better-auth": "^1.7.3",
    "better-auth-mikro-orm": "1.0.0-next.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "clsx": "2.1.1",
    "exifreader": "catalog:",
    "file-type": "catalog:",
    "graphql": "^16.14.2",
    "ical-generator": "catalog:",
    "jose": "^6.2.12",
    "keyv": "catalog:",
    "langchain": "catalog:langchain",
    "mime-types": "catalog:",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "catalog:",
    "react-email": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^2.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestposts/ai": "workspace:*",
    "@nestposts/auth": "workspace:*",
    "@nestposts/database": "workspace:*",
    "@nestposts/langgraph-checkpoint-aws": "workspace:*",
    "@nestposts/migrator": "workspace:*",
    "@nestposts/observability": "workspace:*",
    "@nestposts/organizations": "workspace:*",
    "@nestposts/posts-agent": "workspace:*",
    "@nestposts/redis": "workspace:*"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tools/webpack/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "webpack-cli build",
          "args": [
            "--config-node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--config-node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {},
      "copy-workspace-modules": {},
      "prune": {},
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "@nestposts/theo-agent:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@nestposts/theo-agent:build:development"
          },
          "production": {
            "buildTarget": "@nestposts/theo-agent:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "prune"
        ],
        "options": {
          "cwd": "apps/theo-agent",
          "args": [
            "--platform linux/arm64",
            "--tag nestposts/theo-agent:dev"
          ]
        },
        "parallelism": false
      },
      "docker:run": {
        "options": {
          "cwd": ".",
          "command": "docker run {args} nestposts/theo-agent:dev"
        }
      }
    }
  }
}
