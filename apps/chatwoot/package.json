{
  "name": "@chatwoot/chatwoot",
  "version": "4.18.0",
  "license": "MIT",
  "scripts": {
    "eslint": "eslint app/**/*.{js,vue}",
    "eslint:fix": "eslint app/**/*.{js,vue} --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "TZ=UTC vitest --no-watch --no-cache --no-coverage --logHeapUsage",
    "test:watch": "TZ=UTC vitest --no-cache --no-coverage",
    "test:coverage": "TZ=UTC vitest --no-watch --no-cache --coverage",
    "start:dev": "foreman start -f ./Procfile.dev",
    "start:test": "RAILS_ENV=test foreman start -f ./Procfile.test",
    "ruby:prettier": "bundle exec rubocop -a",
    "build:sdk": "vite build --config vite.lib.config.ts",
    "size": "size-limit",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "sync:i18n": "bin/sync_i18n_file_change"
  },
  "size-limit": [
    {
      "path": "public/vite/assets/widget-*.js",
      "limit": "300 KB"
    },
    {
      "path": "public/packs/js/sdk.js",
      "limit": "40 KB"
    }
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "migrate": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@nestposts/migrator:build"
        ],
        "options": {
          "parallel": false,
          "commands": [
            "cd apps/chatwoot && BUNDLE_GEMFILE=Gemfile SKIP_TEST_DATABASE=true bundle exec rails db:migrate",
            "node apps/migrator/dist/main.js chatwoot:mirror"
          ]
        }
      },
      "fresh": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/chatwoot",
          "command": "bundle exec rails db:migrate:reset",
          "env": {
            "BUNDLE_GEMFILE": "Gemfile",
            "SKIP_TEST_DATABASE": "true"
          }
        }
      },
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "cwd": "apps/chatwoot",
          "command": "bundle exec vite dev",
          "env": {
            "BUNDLE_GEMFILE": "Gemfile"
          }
        }
      },
      "queue": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "cwd": "apps/chatwoot",
          "command": "bundle exec sidekiq",
          "env": {
            "BUNDLE_GEMFILE": "Gemfile"
          }
        }
      },
      "seed": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/chatwoot",
          "command": "bundle exec rails db:seed",
          "env": {
            "BUNDLE_GEMFILE": "Gemfile"
          }
        }
      },
      "ui-add": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/chatwoot",
          "command": "pnpm dlx shadcn-vue@latest add"
        }
      },
      "graphql:generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/graphql/**/*",
          "{projectRoot}/app/graphql/**/*",
          "{projectRoot}/lib/tasks/graphql.rake",
          "{projectRoot}/Gemfile.lock"
        ],
        "outputs": [
          "{projectRoot}/schema.graphql"
        ],
        "options": {
          "cwd": "apps/chatwoot",
          "command": "bundle exec rails graphql:federation:dump",
          "env": {
            "BUNDLE_GEMFILE": "Gemfile"
          }
        }
      },
      "prune": {
        "executor": "nx:noop"
      },
      "docker:build": {
        "dependsOn": [
          "prune"
        ]
      },
      "setup": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "@nestposts/migrator:setup"
        ],
        "options": {
          "parallel": false,
          "commands": [
            "cd apps/chatwoot && BUNDLE_GEMFILE=Gemfile SKIP_TEST_DATABASE=true bundle exec rails db:chatwoot_prepare",
            "node apps/migrator/dist/main.js chatwoot:mirror"
          ]
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "setup"
        ],
        "options": {
          "cwd": "apps/chatwoot",
          "env": {
            "BUNDLE_GEMFILE": "Gemfile"
          },
          "parallel": true,
          "commands": [
            "FRONTEND_URL=${FRONTEND_URL:-http://localhost:${CHATWOOT_PORT:-3100}} bundle exec rails server -p ${CHATWOOT_PORT:-3100}",
            "bin/vite dev"
          ]
        }
      },
      "test": {
        "executor": "nx:noop",
        "dependsOn": [
          "test:frontend",
          "test:backend"
        ]
      },
      "test:frontend": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/app/javascript/**/*",
          "{projectRoot}/enterprise/app/javascript/**/*",
          "{projectRoot}/vite.config.*",
          "{projectRoot}/package.json"
        ],
        "options": {
          "cwd": "apps/chatwoot",
          "command": "TZ=UTC pnpm exec vitest --no-watch --no-cache --no-coverage"
        }
      },
      "test:backend": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/chatwoot",
          "parallel": false,
          "env": {
            "BUNDLE_GEMFILE": "Gemfile",
            "RAILS_ENV": "test",
            "REDIS_URL": "redis://localhost:6379/15",
            "TZ": "UTC"
          },
          "commands": [
            "bundle exec rails db:create",
            "bundle exec rspec --format progress --format RspecJunitFormatter --out target/test-results/rspec.xml"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.11.10",
    "@apollo/client": "^3.14.1",
    "@breezystack/lamejs": "^1.2.7",
    "@chatwoot/ninja-keys": "1.2.3",
    "@chatwoot/pico-search": "0.6.2",
    "@chatwoot/prosemirror-schema": "1.4.5",
    "@chatwoot/utils": "^0.0.57",
    "@chatwoot/viz": "^0.1.5",
    "@formkit/core": "^1.7.2",
    "@formkit/vue": "^1.7.2",
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@hotwired/turbo-rails": "^8.0.13",
