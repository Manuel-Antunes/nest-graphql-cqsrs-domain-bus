# Chatwoot's Docker image builds standalone (context = apps/chatwoot, only
# package.json + pnpm-lock.yaml + this file are copied before `pnpm i`), so it
# does NOT inherit the monorepo-root .npmrc. Chatwoot is an upstream app written
# for a flat node_modules: app code imports transitive deps directly, e.g.
# `import { toggleMark } from 'prosemirror-commands'` (a transitive of
# @chatwoot/prosemirror-schema). pnpm's default isolated linker hides those from
# the top level, so Vite/Rollup can't resolve them. Match the root config so the
# container resolves modules the same way local dev does.
node-linker=hoisted
