<!DOCTYPE html>
<html>
  <head>
    <title><%= @global_config['INSTALLATION_NAME'] %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, user-scalable=0"/>
    <%# Full parity with the dashboard SPA head: PWA meta, favicons, CSRF, and the %>
    <%# window.chatwootConfig / globalConfig / analytics config the components read. %>
    <%= render 'layouts/frontend_head' %>
    <%= inertia_ssr_head %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'inertia' %>
  </head>
  <body class="text-slate-600">
    <%# Inertia injects <div id="app" data-page="…"></div> here %>
    <%= yield %>
    <noscript id="noscript">This app works best with JavaScript enabled.</noscript>
    <% if @dashboard_scripts.present? %>
      <%= @dashboard_scripts.html_safe %>
    <% end %>
  </body>
</html>
