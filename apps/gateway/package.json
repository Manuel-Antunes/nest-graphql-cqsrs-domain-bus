{
  "name": "@nestposts/gateway",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@nestjs-modules/mailer": "catalog:",
    "@nestposts/asset": "workspace:*",
    "@nestposts/auth": "workspace:*",
    "@nestposts/cqsrs": "workspace:*",
    "@nestposts/database": "workspace:*",
    "@nestposts/lambda": "workspace:*",
    "@nestposts/mail": "workspace:*",
    "@nestposts/notifications": "workspace:*",
    "@nestposts/observability": "workspace:*",
    "@nestposts/organizations": "workspace:*",
    "@nestposts/platform": "workspace:*",
    "@nestposts/redis": "workspace:*",
    "@nestposts/transport-eventbus": "workspace:*",
    "@nestposts/users": "workspace:*",
    "@nestposts/validated-dto": "workspace:*",
    "blurhash": "catalog:",
    "clsx": "catalog:",
    "exifreader": "catalog:",
    "file-type": "catalog:",
    "firebase-admin": "catalog:",
    "html-to-text": "catalog:",
    "ical-generator": "catalog:",
    "mime-types": "catalog:",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:",
    "sharp": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/apps/posts-api/src/graphql/**/*.graphql",
          "{workspaceRoot}/apps/notificator/src/graphql/**/*.graphql",
          "{workspaceRoot}/tools/webpack/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "webpack-cli build",
          "args": [
            "--config-node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--config-node-env=development"
            ]
          }
        }
      },
      "supergraph": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/apps/posts-api/src/graphql/**/*.graphql",
          "{workspaceRoot}/apps/notificator/src/graphql/**/*.graphql"
        ],
        "outputs": [
          "{projectRoot}/dist/supergraph"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "node dist/compose.js"
        }
      },
      "prune-lockfile": {},
      "copy-workspace-modules": {},
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "supergraph"
        ]
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "@nestposts/gateway:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@nestposts/gateway:build:development"
          },
          "production": {
            "buildTarget": "@nestposts/gateway:build:production"
          }
        }
      },
      "docker:build": {
        "options": {
          "args": [
            "--file apps/gateway/Dockerfile",
            "--tag nestposts/gateway:dev"
          ]
        },
        "parallelism": false
      },
      "docker:run": {
        "options": {
          "cwd": ".",
          "command": "docker run {args} nestposts/gateway:dev"
        }
      }
    }
  },
  "devDependencies": {
    "@nestposts/migrator": "workspace:*"
  }
}
