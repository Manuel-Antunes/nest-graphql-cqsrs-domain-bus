{
  "name": "@nestposts/posts-api",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "@nestposts/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@nestjs-modules/mailer": "catalog:",
    "@nestposts/asset": "workspace:*",
    "@nestposts/auth": "workspace:*",
    "@nestposts/cqsrs": "workspace:*",
    "@nestposts/database": "workspace:*",
    "@nestposts/lambda": "workspace:*",
    "@nestposts/microservices-aws": "workspace:*",
    "@nestposts/microservices-inngest": "workspace:*",
    "@nestposts/notifications": "workspace:*",
    "@nestposts/observability": "workspace:*",
    "@nestposts/organizations": "workspace:*",
    "@nestposts/platform": "workspace:*",
    "@nestposts/posts": "workspace:*",
    "@nestposts/transport-eventbus": "workspace:*",
    "@nestposts/users": "workspace:*",
    "@nestposts/validated-dto": "workspace:*",
    "clsx": "catalog:",
    "firebase-admin": "catalog:",
    "flydrive": "catalog:",
    "html-to-text": "catalog:",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/apps/migrator/src/migrations/tenant/**/*.ts",
          "{workspaceRoot}/tools/webpack/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "webpack-cli build",
          "args": [
            "--config-node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--config-node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "@nestposts/posts-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@nestposts/posts-api:build:development"
          },
          "production": {
            "buildTarget": "@nestposts/posts-api:build:production"
          }
        }
      },
      "test-e2e": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "vitest run --config vitest.e2e.config.mts"
        }
      },
      "docker:build": {
        "options": {
          "args": [
            "--file apps/posts-api/Dockerfile",
            "--tag nestposts/posts-api:dev"
          ]
        },
        "parallelism": false
      },
      "docker:run": {
        "options": {
          "cwd": ".",
          "command": "docker run {args} nestposts/posts-api:dev"
        }
      }
    }
  },
  "devDependencies": {
    "@camcima/nestjs-memory-microservices": "^0.3.0",
    "@nestposts/migrator": "workspace:*"
  }
}
