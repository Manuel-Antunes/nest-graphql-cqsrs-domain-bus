{
  "name": "@nestposts/tagging",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@nestjs-modules/mailer": "catalog:",
    "@nestposts/cqsrs": "workspace:*",
    "@nestposts/database": "workspace:*",
    "@nestposts/lambda": "workspace:*",
    "@nestposts/microservices-aws": "workspace:*",
    "@nestposts/microservices-inngest": "workspace:*",
    "@nestposts/observability": "workspace:*",
    "@nestposts/platform": "workspace:*",
    "@nestposts/posts": "workspace:*",
    "@nestposts/retry-policy": "workspace:*",
    "@nestposts/transport-eventbus": "workspace:*",
    "@nestposts/users": "workspace:*",
    "firebase-admin": "catalog:",
    "flydrive": "catalog:",
    "html-to-text": "catalog:",
    "nodemailer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/apps/migrator/src/migrations/tenant/**/*.ts",
          "{workspaceRoot}/tools/webpack/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "webpack-cli build",
          "args": [
            "--config-node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--config-node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "dependsOn": [
          {
            "projects": [
              "@nestposts/migrator"
            ],
            "target": "setup"
          }
        ],
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "@nestposts/tagging:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@nestposts/tagging:build:development"
          },
          "production": {
            "buildTarget": "@nestposts/tagging:build:production"
          }
        }
      },
      "docker:build": {
        "options": {
          "args": [
            "--file apps/tagging/Dockerfile",
            "--tag nestposts/tagging:dev"
          ]
        },
        "parallelism": false
      },
      "docker:run": {
        "options": {
          "cwd": ".",
          "command": "docker run {args} nestposts/tagging:dev"
        }
      }
    }
  },
  "devDependencies": {
    "@camcima/nestjs-memory-microservices": "^0.3.0",
    "@nestposts/migrator": "workspace:*"
  }
}
