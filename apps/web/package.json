{
  "name": "@nestposts/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "graphql-codegen --config codegen.ts && next build"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@base-ui/react": "catalog:",
    "@better-auth-ui/core": "catalog:",
    "@better-auth-ui/react": "catalog:",
    "@better-auth/oauth-provider": "^1.7.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/postgresql": "^7.2.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestposts/auth": "workspace:*",
    "@nestposts/cqsrs": "workspace:*",
    "@nestposts/database": "workspace:*",
    "@nestposts/microservices-aws": "workspace:*",
    "@nestposts/microservices-inngest": "workspace:*",
    "@nestposts/migrator": "workspace:*",
    "@nestposts/notifications": "workspace:*",
    "@nestposts/organizations": "workspace:*",
    "@nestposts/transport-eventbus": "workspace:*",
    "@nestposts/ui": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-graphql": "^0.70.0",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-pacer": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-store": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@vercel/otel": "^2.1.3",
    "better-auth": "^1.7.3",
    "better-auth-mikro-orm": "1.0.0-next.2",
    "bowser": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cn": "catalog:",
    "date-fns": "catalog:",
    "graphql": "^16.14.2",
    "graphql-sse": "^2.6.1",
    "graphql-ws": "^6.2.1",
    "input-otp": "catalog:",
    "lucide-react": "^0.545.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-codegen/fragment-matcher": "^7.1.0",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "graphql-sse": "^2.6.1",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "tw-animate-css": "catalog:"
  },
  "nx": {
    "targets": {
      "codegen": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/apps/posts-api/src/graphql/**/*.graphql",
          "{workspaceRoot}/apps/notificator/src/graphql/**/*.graphql",
          "{projectRoot}/federation.graphql",
          "{projectRoot}/codegen.ts",
          "{projectRoot}/src/**/*.{ts,tsx}"
        ],
        "outputs": [
          "{projectRoot}/src/gql"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "graphql-codegen --config codegen.ts"
        },
        "dependsOn": [
          {
            "projects": [
              "@nestposts/gateway"
            ],
            "target": "supergraph"
          }
        ]
      },
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "codegen",
          "^build"
        ],
        "inputs": [
          "production",
          {
            "env": "NEXT_PUBLIC_GATEWAY_URL"
          }
        ],
        "outputs": [
          "{projectRoot}/.next"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "next build"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "codegen"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "next dev -p 4200"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "codegen",
          "^build"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "tsc --noEmit"
        }
      },
      "ui-add": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm dlx shadcn@latest add",
          "cwd": "apps/web",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.ui.json"
          }
        }
      },
      "docker:build": {
        "options": {
          "args": [
            "--file apps/web/Dockerfile",
            "--tag nestposts/web:dev"
          ]
        },
        "parallelism": false
      },
      "docker:run": {
        "options": {
          "cwd": ".",
          "command": "docker run {args} nestposts/web:dev"
        }
      }
    }
  }
}
