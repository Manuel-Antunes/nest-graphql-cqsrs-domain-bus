{
  "name": "@nestposts/web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@base-ui/react": "^1.8.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/postgresql": "^7.2.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestposts/auth": "workspace:*",
    "@nestposts/database": "workspace:*",
    "@nestposts/organizations": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-graphql": "^0.70.0",
    "@vercel/otel": "^2.1.3",
    "better-auth": "^1.7.3",
    "better-auth-mikro-orm": "1.0.0-next.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.2.1",
    "lucide-react": "^0.545.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-codegen/fragment-matcher": "^7.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "nx": {
    "targets": {
      "codegen": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/apps/posts-api/src/graphql/**/*.graphql",
          "{projectRoot}/codegen.ts",
          "{projectRoot}/src/**/*.{ts,tsx}"
        ],
        "outputs": [
          "{projectRoot}/src/gql"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "graphql-codegen --config codegen.ts"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "codegen"
        ],
        "inputs": [
          "production",
          {
            "env": "NEXT_PUBLIC_GRAPHQL_URL"
          }
        ],
        "outputs": [
          "{projectRoot}/.next"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "next build"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "continuous": true,
        "dependsOn": [
          "codegen"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "next dev -p 4200"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "codegen"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "command": "tsc --noEmit"
        }
      }
    }
  }
}
