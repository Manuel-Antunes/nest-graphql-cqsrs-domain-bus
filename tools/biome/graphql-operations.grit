// The naming rules `@graphql-eslint` enforced on the operations, which Biome does not ship.
//
// With `javascript.experimentalEmbeddedSnippetsEnabled`, Biome formats the document inside every
// `graphql(`…`)` and runs its own GraphQL rules on it — anonymous operations, duplicate fields,
// variables and arguments. What it has no rule for is naming, so this reads the document as TEXT,
// from the call expression, and checks the three conventions the old `naming-convention` config
// held. Everything that needs a schema is left to codegen, which fails the build on it.
//
// EVERY regex here is anchored: `<:` matches the WHOLE node, not a substring, so a "contains"
// pattern is written `(?s).*…*`. Left off, the rule compiles, loads, reports nothing and looks
// like a rule.
//
// A capturing regex binds one match. Every `graphql()` here holds one operation or one fragment,
// which is all the two name rules need; the variable rule captures nothing and sees every
// definition.

language js

or {
  // `FragmentDefinition: requiredPattern` from the old config: `<Owner>_<field>`, as in
  // `PostCard_post`. It is what makes a fragment's owner readable at the spread site, and what
  // `fragmentMasking` names the unmask function after.
  `graphql($document)` where {
    $document <: r"(?s).*\bfragment\s+([A-Za-z0-9_]+)\s+on\b.*"($name),
    $name <: not r"[A-Z][A-Za-z0-9]*_[a-z][A-Za-z0-9]*",
    register_diagnostic(span=$document, message="A fragment is named `<Owner>_<field>` — `PostCard_post`, `TagList_post`. The codegen'd unmask helper and every spread site read that name.", severity="error")
  },
  // `OperationDefinition` from `operations-recommended`: PascalCase, and the keyword is not
  // repeated in the name — `query FeedPosts`, not `query GetFeedPostsQuery`. The codegen'd type is
  // the name plus the keyword, so a repeated one reads `GetFeedPostsQueryQuery`.
  `graphql($document)` where {
    $document <: r"(?s).*\b(?:query|mutation|subscription)\s+([A-Za-z0-9_]+).*"($name),
    $name <: or {
      not r"_*[A-Z][A-Za-z0-9]*",
      r"_*(?:Query|Mutation|Subscription|Get).*",
      r".*(?:Query|Mutation|Subscription)"
    },
    register_diagnostic(span=$document, message="An operation is named in PascalCase, without the keyword in it — `FeedPosts`, not `GetFeedPostsQuery`. Codegen appends the keyword to the type it generates.", severity="error")
  },
  // `VariableDefinition: camelCase`, with the old config's leading underscore allowed.
  `graphql($document)` where {
    $document <: r"(?s).*\$_*(?:[A-Z]|[A-Za-z0-9]+_)[A-Za-z0-9_]*\s*:.*",
    register_diagnostic(span=$document, message="A variable is named in camelCase — `$postId`, not `$PostId` or `$post_id`.", severity="error")
  }
}
