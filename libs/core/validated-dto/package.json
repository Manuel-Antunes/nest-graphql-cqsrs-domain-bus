{
  "name": "@nestposts/validated-dto",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nestposts/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mixins": {
      "@nestposts/source": "./src/mixins/index.ts",
      "types": "./dist/mixins/index.d.ts",
      "require": "./dist/mixins/index.js",
      "default": "./dist/mixins/index.js"
    },
    "./schemas/registries": {
      "@nestposts/source": "./src/schemas/registries/index.ts",
      "types": "./dist/schemas/registries/index.d.ts",
      "require": "./dist/schemas/registries/index.js",
      "default": "./dist/schemas/registries/index.js"
    },
    "./*": {
      "@nestposts/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {}
}
