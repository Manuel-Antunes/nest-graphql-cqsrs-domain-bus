{
  "name": "@nestposts/graphql-response-cache",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nestposts/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "@nestposts/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@graphql-yoga/plugin-response-cache": "catalog:",
    "@nestjs/cache-manager": "catalog:",
    "cache-manager": "catalog:"
  },
  "devDependencies": {
    "@nestposts/redis": "workspace:*"
  }
}
