{
  "name": "@nestposts/asset",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "@nestposts/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@nestposts/database": "workspace:*",
    "blurhash": "catalog:",
    "exifreader": "catalog:",
    "file-type": "catalog:",
    "flydrive": "catalog:",
    "mime-types": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/mime-types": "catalog:"
  }
}
