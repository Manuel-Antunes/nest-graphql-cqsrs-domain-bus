{
  "name": "@nestposts/auth",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "@nestposts/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@nestposts/database": "workspace:*",
    "@nestposts/mail": "workspace:*",
    "@nestposts/notifications": "workspace:*",
    "@nestposts/platform": "workspace:*",
    "@nestposts/users": "workspace:*",
    "@nestposts/validated-dto": "workspace:*",
    "clsx": "catalog:",
    "react": "catalog:",
    "react-email": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:"
  }
}
