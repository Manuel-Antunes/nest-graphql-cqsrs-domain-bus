{
  "name": "@nestposts/ui",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./styles/*": "./src/styles/*",
    "./postcss.config": "./postcss.config.js",
    "./server": "./src/server.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.tsx",
    "./components/*": "./src/components/*.tsx"
