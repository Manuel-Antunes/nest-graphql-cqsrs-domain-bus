    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nx/docker": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "catalog:",
    "@nx/nest": "catalog:",
    "@nx/next": "catalog:",
    "@nx/playwright": "catalog:",
    "@nx/vite": "23.2.1",
