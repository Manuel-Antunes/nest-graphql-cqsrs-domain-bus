{
  "name": "@nestposts/source",
  "version": "0.1.0",
  "description": "POC: NestJS + @nestjs/cqrs + MikroORM v7 + GraphQL (Apollo) com subscriptions alimentadas pelo EventBus do CQRS \u2014 reescrita em TypeScript do axon-graphql-posts",
  "private": true,
  "license": "MIT",
  "author": "Manuel Antunes",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm db:setup && nx run-many -t serve",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:e2e": "nx run @nestposts/posts-api:test-e2e",
    "test:all": "nx run-many -t test test-e2e e2e",
    "graph": "nx graph",
    "db:setup": "nx run @nestposts/migrator:setup",
    "db:migrate": "nx run @nestposts/migrator:migrate",
    "db:migrate:tagging": "nx run @nestposts/migrator:migrate:tagging",
    "db:revert": "nx run @nestposts/migrator:revert",
    "db:revert:tagging": "nx run @nestposts/migrator:revert:tagging",
    "db:fresh": "nx run @nestposts/migrator:fresh",
    "db:fresh:tagging": "nx run @nestposts/migrator:fresh:tagging",
    "db:seed": "nx run @nestposts/migrator:seed",
    "db:migration:create": "nx run @nestposts/migrator:migration-generate",
    "db:migration:create:tagging": "nx run @nestposts/migrator:migration-generate:tagging",
    "db:seeder:create": "nx run @nestposts/migrator:seeder-generate",
    "test:web": "nx run @nestposts/web-e2e:e2e"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@automapper/classes": "^9.0.2",
    "@automapper/core": "^9.0.2",
    "@automapper/nestjs": "^9.0.2",
    "@better-auth/oauth-provider": "^1.7.3",
    "@casl/ability": "^7.0.1",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/decorators": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.1",
    "@mikro-orm/seeder": "^7.2.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/microservices": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "better-auth": "^1.7.3",
    "better-auth-mikro-orm": "1.0.0-next.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dset": "^3.1.4",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@camcima/nestjs-memory-microservices": "^0.3.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@mikro-orm/cli": "^7.2.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nx/docker": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/playwright": "^23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^11.7.1",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "graphql-ws": "^6.2.1",
    "jsonc-eslint-parser": "^3.3.0",
    "nx": "23.2.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sst": "^4.17.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
