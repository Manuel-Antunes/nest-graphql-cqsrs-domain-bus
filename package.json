    "@nx/workspace": "catalog:",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.2",
    "@swc/helpers": "~0.5.18",
    "@testcontainers/postgresql": "^11.7.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "graphql-sse": "^2.6.1",
    "inngest": "^4.21.0",
    "jsonc-eslint-parser": "^3.3.0",
