{
  "name": "@nestposts/source",
  "version": "0.1.0",
  "description": "POC: NestJS + @nestjs/cqrs + MikroORM v7 + GraphQL (Apollo) com subscriptions alimentadas pelo EventBus do CQRS — reescrita em TypeScript do axon-graphql-posts",
  "private": true,
  "license": "MIT",
  "author": "Manuel Antunes",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm db:setup && nx run-many -t serve",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint && prettier --check .",
    "test": "nx run-many -t test",
    "trivy": "nx run-many --target trivy --all",
    "build:skip-lint": "nx run-many --target build --configuration=skip-lint",
    "build:all": "nx run-many --target build --all",
    "affected:all": "nx affected --target build",
    "lint:fix": "nx run-many -t lint -c fix --skip-nx-cache && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many -t typecheck",
    "test:e2e": "nx run-many -t test-e2e --parallel=1",
    "test:web": "nx run @nestposts/web-e2e:test-e2e",
    "test:all": "nx run-many -t test && nx run-many -t test-e2e --parallel=1",
    "graph": "nx graph",
    "graph:stack": "./infra/scripts/stack-graph.sh",
    "infra:deploy": "nx run @nestposts/infra:deploy",
    "infra:dev": "nx run @nestposts/infra:dev",
    "infra:diff": "nx run @nestposts/infra:diff",
    "infra:remove": "nx run @nestposts/infra:remove",
    "db:setup": "nx run @nestposts/migrator:setup",
    "db:migrate": "nx run @nestposts/migrator:migrate",
    "db:migrate:tagging": "nx run @nestposts/migrator:migrate:tagging",
    "db:revert": "nx run @nestposts/migrator:revert",
    "db:revert:tagging": "nx run @nestposts/migrator:revert:tagging",
    "db:fresh": "nx run @nestposts/migrator:fresh",
    "db:fresh:tagging": "nx run @nestposts/migrator:fresh:tagging",
    "db:seed": "nx run @nestposts/migrator:seed",
    "db:migration:create": "nx run @nestposts/migrator:migration-generate",
    "db:migration:create:tagging": "nx run @nestposts/migrator:migration-generate:tagging",
    "db:seeder:create": "nx run @nestposts/migrator:seeder-generate"
  },
